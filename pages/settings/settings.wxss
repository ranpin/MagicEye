.settings-page {
  min-height: 100vh;
  background: var(--bg-dark);
  padding: 0 0 80rpx;
}

/* ===== 头部 ===== */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 48rpx;
  background: linear-gradient(180deg, var(--bg-mid) 0%, var(--bg-dark) 100%);
}

.header-emoji {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.header-version {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* ===== 设置组 ===== */
.settings-group {
  margin: 32rpx 24rpx 0;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  overflow: hidden;
}

.group-title {
  display: block;
  font-size: 24rpx;
  color: var(--text-muted);
  padding: 24rpx 32rpx 12rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: rgba(255, 255, 255, 0.05);
}

.setting-label {
  font-size: 30rpx;
  color: var(--text-primary);
}

.setting-value {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-value text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.arrow {
  font-size: 32rpx;
  color: var(--text-muted);
}

.setting-item-col {
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.setting-input {
  width: 100%;
  height: 64rpx;
  padding: 0 16rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 12rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-family: monospace;
}

.setting-hint {
  font-size: 22rpx;
  color: var(--text-muted);
}

/* ===== 底部 ===== */
.footer {
  display: flex;
  justify-content: center;
  padding: 64rpx 0;
}

.footer-text {
  font-size: 22rpx;
  color: var(--text-muted);
}
